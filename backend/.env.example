# MongoDB Connection
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/eatwelthy?retryWrites=true&w=majority

# JWT Secret (use a strong random string in production)
JWT_SECRET=your_jwt_secret_key_here

# Cookie Session Keys (use random strings)
COOKIE_KEY_1=your_cookie_key_1_here
COOKIE_KEY_2=your_cookie_key_2_here

# Brevo (Sendinblue) Email API Key
# Get from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your_brevo_api_key_here

# Environment
NODE_ENV=development

# Port
PORT=5050

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5050/users/google/callback
CLIENT_URL=http://localhost:3000
BACKEND_URL=http://localhost:5050
